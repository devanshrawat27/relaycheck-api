# RelayCheck Control API - placeholder values only.
# Copy to .env before overriding anything.
# Never commit a real .env file or real credentials.

# HTTP port for this service.
PORT=3200

# Platform database (this API is the sole writer of RelayCheck platform tables).
DATABASE_URL=postgresql://relaycheck:relaycheck@localhost:5432/relaycheck

# RabbitMQ for run-job dispatch.
AMQP_URL=amqp://guest:guest@localhost:5672

# Shared credential for the private runner-reporting endpoints.
INTERNAL_API_TOKEN=placeholder-internal-token

# Only used by the end-to-end smoke script to clean up receiver rows.
SMOKE_DEMO_DATABASE_URL=postgresql://relaycheck:relaycheck@localhost:5432/relaycheck_demo

# Optional bearer token for the public run endpoints. Unset = local-only
# loopback default. Set this (and the same value in relaycheck-web) if you
# override HOST or expose the API beyond this machine.
API_AUTH_TOKEN=

# Optional local safety valve for the public API.
RATE_LIMIT_PER_MINUTE=120
# 0 = unlimited. Applies per UTC day across all runs.
API_MAX_RUNS_PER_DAY=0

# Outbound email (email verification + password reset) via SMTP.
# Defaults to the local Mailpit container started by infra/docker-compose.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RelayCheck <no-reply@relaycheck.local>

# Optional email address to receive alerts when a run fails or errors.
# Unset = no alerting (local-first default).
ALERT_EMAIL=