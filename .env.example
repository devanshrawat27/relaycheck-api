# RelayCheck Control API - placeholder values only.
# Copy to .env before overriding anything.
# Never commit a real .env file or real credentials.

# HTTP port for this service.
PORT=3200

# Platform database (this API is the sole writer of RelayCheck platform tables).
DATABASE_URL=postgresql://relaycheck:relaycheck@localhost:5432/relaycheck

# Shared credential for the private runner-reporting endpoints (wired in the
# queue/lifecycle task). Keep a placeholder; use a real random value locally.
INTERNAL_API_TOKEN=placeholder-internal-token
