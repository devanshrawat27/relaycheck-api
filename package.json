{
  "name": "@relaycheck/control-api",
  "version": "0.1.0",
  "private": true,
  "description": "RelayCheck Control API - validates run requests, owns and writes RelayCheck platform tables, publishes run jobs to RabbitMQ, serves public run contracts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "smoke": "node scripts/smoke.mjs",
    "smoke:stack": "node scripts/smoke-stack.mjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.16.0",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.16.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
