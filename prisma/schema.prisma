generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RelayCheck platform tables. The Control API is the sole writer;
// the Scenario Runner never connects directly to these tables.

model User {
  id           String       @id
  email        String       @unique
  passwordHash String
  role         String       @default("user")
  createdAt    DateTime     @default(now())

  memberships  Membership[]
  sessions     Session[]

  @@map("users")
}

model Workspace {
  id          String       @id
  name        String
  createdAt   DateTime     @default(now())

  memberships Membership[]
  runs        TestRun[]

  @@map("workspaces")
}

model Membership {
  userId      String
  workspaceId String
  role        String   @default("owner")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@map("memberships")
}

// Opaque, revocable sessions. Only the SHA-256 hash of the token is stored.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model TestRun {
  id          String    @id
  workspaceId String?
  scenario    String
  status      String    @default("queued")
  params      Json
  summary     String?
  safeError   String?
  claimedBy   String?
  leaseExpiresAt DateTime?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  attempts   DeliveryAttempt[]
  assertions AssertionResult[]

  @@index([status, createdAt])
  @@index([workspaceId, createdAt])
  @@map("test_runs")
}

model DeliveryAttempt {
  id            Int      @id @default(autoincrement())
  runId         String
  attemptNumber Int
  eventId       String
  httpStatus    Int?
  outcome       String
  durationMs    Int
  errorDetail   String?
  createdAt     DateTime @default(now())

  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("delivery_attempts")
}

model AssertionResult {
  id         Int      @id @default(autoincrement())
  runId      String
  name       String
  expected   String
  actual     String
  passed     Boolean
  createdAt  DateTime @default(now())

  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("assertion_results")
}

// Transactional outbox: a run row and its job payload commit together, so a
// crash between persistence and publishing cannot strand a queued run.
model OutboxEvent {
  id          String    @id
  runId       String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}
