# RelayCheck local infrastructure - placeholder values only.
# Copy to .env in this folder before overriding anything.
# Never commit a real .env file or real credentials.

POSTGRES_USER=relaycheck
POSTGRES_PASSWORD=relaycheck
POSTGRES_DB=relaycheck
POSTGRES_PORT=5432

RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Connection strings consumed by the services.
# Platform database (Control API):
DATABASE_URL=postgresql://relaycheck:relaycheck@localhost:5432/relaycheck
# Demo receiver database:
DEMO_DATABASE_URL=postgresql://relaycheck:relaycheck@localhost:5432/relaycheck_demo
AMQP_URL=amqp://guest:guest@localhost:5672
